# Sobelow's settings: `mix sobelow` (or scripts/sobelow, which CI and the
# pre-push hook use) reads this file.
#
# A finding that was looked at and is fine carries a `# sobelow_skip [...]`
# comment above its function, with the reason beside it (see lib/avwe/store.ex),
# so a new one still fails the scan. Ignoring a whole check here is only for
# what cannot apply.
[
  exit: :low,
  format: "txt",
  ignore: [],
  ignore_files: [],
  include_mix_tasks: false,
  include_scripts: false,
  out: nil,
  private: true,
  skip: true,
  summary: false,
  threshold: :low,
  verbose: false
]
